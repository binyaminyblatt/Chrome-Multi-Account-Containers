{
  "manifest_version": 3,
  "name": "Chrome Multi-Account Containers",
  "version": "1.3.0",
  "description": "Firefox-style Multi-Account Containers for Chrome with Enterprise Policy support, Temporary Containers, Split View, and storage isolation.",
  "permissions": [
    "tabs",
    "tabGroups",
    "cookies",
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "scripting",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open Multi-Account Containers popup"
    },
    "open-temp-container": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Open a new Temporary Container tab"
    },
    "reopen-in-temp-container": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Reopen current tab in a Temporary Container"
    },
    "duplicate-in-temp-container": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Duplicate current tab in a Temporary Container"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
